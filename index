    <script>
        document.addEventListener("DOMContentLoaded", function() {
            
            // --- PROFESIONÁLNÍ MONITORING FPS ---
            let isLowPerformance = false;
            
            function monitorPerformance() {
                let frameCount = 0;
                let startTime = performance.now();
                
                function checkFPS(now) {
                    frameCount++;
                    if (now - startTime >= 1000) { // Test trvá přesně 1 sekundu
                        const fps = Math.round((frameCount * 1000) / (now - startTime));
                        
                        // Hranice plynulosti u starších PC (pod 45 FPS přepínáme do low-perf)
                        if (fps < 45) {
                            isLowPerformance = true;
                            document.body.classList.add("low-perf");
                            
                            // Úplně vymažeme cihličky z paměti, aby nezatěžovaly procesor
                            const bricksBg = document.getElementById("bricksContainer");
                            if (bricksBg) bricksBg.remove();
                            
                            console.log(`[Perf Monitor] Detekován slabší hardware (${fps} FPS). Animace byly bezpečně vypnuty.`);
                        } else {
                            console.log(`[Perf Monitor] Výkon v pořádku (${fps} FPS).`);
                        }
                    } else {
                        requestAnimationFrame(checkFPS);
                    }
                }
                requestAnimationFrame(checkFPS);
            }
            // Spuštění testu ihned po načtení
            monitorPerformance();
            // -------------------------------------

            const galleryApi = window.VDGallery;
            const hamburger = document.getElementById("hamburger");
            const navMenu = document.getElementById("nav-menu");
            const navLinks = document.querySelectorAll("#nav-menu li a");
            const backToTopBtn = document.getElementById("backToTop");

            const zakazkyPrehled = document.getElementById("zakazky-prehled");
            const detailyBlok = document.getElementById("zakazka-detaily-blok");
            const detailyNazev = document.getElementById("detaily-nazev");
            const detailyFotkyGrid = document.getElementById("detaily-fotky-grid");
            const zavritDetailyBtn = document.getElementById("zavrit-detaily");

            const lightbox = document.getElementById("lightbox");
            const lightboxImg = document.getElementById("lightbox-img");
            const lightboxClose = document.getElementById("lightbox-close");
            const lightboxNext = document.getElementById("lightbox-next");
            const lightboxPrev = document.getElementById("lightbox-prev");

            let rawZakazky = [];
            let nacteneZakazky = [];
            let aktivniFotkyKolekce = [];
            let aktivniZakazka = null;
            let aktualniIndex = 0;
            let lastBackToTopState = false;

            let gallerySettings = galleryApi.getStoredSettings();

            const revealObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("active");
                        observer.unobserve(entry.target);
                    }
                });
            }, { rootMargin: "0px 0px -50px 0px", threshold: 0.1 });

            function observeRevealElements(scope = document) {
                // Pokud máme nízké FPS, nezatěžujeme prohlížeč sledováním elementů
                if (isLowPerformance) return; 
                scope.querySelectorAll(".reveal:not(.active)").forEach(element => revealObserver.observe(element));
            }

            function updateBackToTopVisibility() {
                const shouldBeVisible = window.scrollY > 400;
                if (shouldBeVisible === lastBackToTopState) return;
                backToTopBtn.classList.toggle("visible", shouldBeVisible);
                lastBackToTopState = shouldBeVisible;
            }

            hamburger.addEventListener("click", () => {
                hamburger.classList.toggle("active");
                navMenu.classList.toggle("active");
            });

            navLinks.forEach(link => {
                link.addEventListener("click", () => {
                    hamburger.classList.remove("active");
                    navMenu.classList.remove("active");
                });
            });

            window.addEventListener("scroll", updateBackToTopVisibility, { passive: true });
            updateBackToTopVisibility();
            observeRevealElements();

            function applyPublicGalleryLayout() {
                const layout = gallerySettings.layout || {};
                document.documentElement.style.setProperty("--public-project-columns", String(layout.publicProjectColumns || 3));
                document.documentElement.style.setProperty("--public-detail-columns", String(layout.publicDetailColumns || 5));
            }

            applyPublicGalleryLayout();

            window.addEventListener("storage", event => {
                if (event.key !== galleryApi.STORAGE_KEY) return;
                gallerySettings = galleryApi.getStoredSettings();
                applyPublicGalleryLayout();
                renderZakazky();
            });

            fetch("gallery/galerie.json")
                .then(response => {
                    if (!response.ok) throw new Error("Soubor galerie.json nebyl nalezen.");
                    return response.json();
                })
                .then(data => {
                    if (!data.zakazky || data.zakazky.length === 0) {
                        zakazkyPrehled.innerHTML = '<p style="text-align: center;">Aktuálně zde nejsou žádné reference.</p>';
                        return;
                    }

                    rawZakazky = data.zakazky;

                    if (!gallerySettings.customOrder.length) {
                        gallerySettings.customOrder = galleryApi.createCustomOrder(rawZakazky);
                        gallerySettings = galleryApi.saveSettings(gallerySettings);
                    }

                    applyPublicGalleryLayout();
                    renderZakazky();
                })
                .catch(error => {
                    console.error(error);
                    zakazkyPrehled.innerHTML = '<p style="text-align: center; color: red; font-weight: bold;">Chyba: Nepodařilo se načíst reference. Zkontrolujte soubor galerie.json.</p>';
                });

            function ziskejAktualniZakazky() {
                return galleryApi.applyGalleryPreferences(rawZakazky, gallerySettings);
            }

            function renderZakazky() {
                nacteneZakazky = ziskejAktualniZakazky();

                if (!nacteneZakazky.length) {
                    zakazkyPrehled.innerHTML = '<p style="text-align: center;">Aktuálně zde nejsou žádné reference.</p>';
                    return;
                }

                zakazkyPrehled.innerHTML = nacteneZakazky.map(zakazka => {
                    const uvodniFotkaCesta = zakazka._coverPhoto
                        ? `gallery/${zakazka.slozka}/${zakazka._coverPhoto}`
                        : "";
                    const vRealizaci = zakazka._inProgress === true;

                    return `
                        <article class="zakazka-karta reveal ${vRealizaci ? "v-realizaci-karta" : ""}">
                            ${vRealizaci ? '<div class="badge-realizace"><i class="fa-solid fa-helmet-safety"></i> V realizaci</div>' : ""}
                            <div class="zakazka-cover">
                                ${uvodniFotkaCesta ? `<img src="${uvodniFotkaCesta}" alt="${zakazka._displayName}" loading="lazy">` : ""}
                            </div>
                            <div class="zakazka-obsah">
                                <div>
                                    <h3>${zakazka._displayName}</h3>
                                </div>
                                <div class="zakazka-footer">
                                  <button class="btn otevrit-galerii" data-id="${zakazka._id}"><i class="fa-solid fa-images"></i> Ukázat stavbu</button>
                                </div>
                            </div>
                        </article>
                    `;
                }).join("");

                observeRevealElements(zakazkyPrehled);

                zakazkyPrehled.querySelectorAll(".otevrit-galerii").forEach(button => {
                    button.addEventListener("click", () => {
                        otevriZakazku(button.getAttribute("data-id"));
                    });
                });
            }

            function otevriZakazku(id) {
                const zakazka = nacteneZakazky.find(item => item._id === id);
                if (!zakazka) return;

                aktivniZakazka = zakazka;
                detailyNazev.innerText = zakazka._displayName;
                detailyFotkyGrid.innerHTML = "";
                aktivniFotkyKolekce = [];

                zakazka._photos.forEach((fotka, index) => {
                    const plnaCesta = `gallery/${zakazka.slozka}/${fotka}`;
                    aktivniFotkyKolekce.push(plnaCesta);

                    const item = document.createElement("div");
                    item.className = "gallery-item";
                    item.innerHTML = `<img src="${plnaCesta}" alt="${zakazka._displayName} - foto ${index + 1}" loading="lazy" data-findex="${index}">`;

                    item.querySelector("img").addEventListener("click", function() {
                        aktualniIndex = Number(this.getAttribute("data-findex"));
                        zobrazLightbox(aktualniIndex);
                    });

                    detailyFotkyGrid.appendChild(item);
                });

                detailyBlok.classList.add("active");
                detailyBlok.scrollIntoView({ behavior: "smooth", block: "start" });
            }

            function zavriDetailZakazky() {
                detailyBlok.classList.remove("active");
                aktivniZakazka = null;
            }

            function zobrazLightbox(index) {
                if (!aktivniFotkyKolekce.length) return;
                lightboxImg.src = aktivkiFotkyKolekce[index];
                lightboxImg.alt = aktivniZakazka ? `${aktivniZakazka._displayName} - foto ${index + 1}` : "Zvětšený náhled";
                lightbox.classList.add("active");
            }

            function zavriLightbox() {
                lightbox.classList.remove("active");
            }

            zavritDetailyBtn.addEventListener("click", () => {
                zavriDetailZakazky();
                document.getElementById("reference").scrollIntoView({ behavior: "smooth", block: "start" });
            });

            lightboxClose.addEventListener("click", zavriLightbox);
            lightboxNext.addEventListener("click", () => {
                if (!aktivniFotkyKolekce.length) return;
                aktualniIndex = (aktualniIndex + 1) % aktivniFotkyKolekce.length;
                zobrazLightbox(aktualniIndex);
            });

            lightboxPrev.addEventListener("click", () => {
                if (!aktivniFotkyKolekce.length) return;
                aktualniIndex = (aktualniIndex - 1 + aktivniFotkyKolekce.length) % aktivniFotkyKolekce.length;
                zobrazLightbox(aktualniIndex);
            });

            lightbox.addEventListener("click", event => {
                if (event.target === lightbox) zavriLightbox();
            });

            document.addEventListener("keydown", event => {
                if (event.key === "Escape") {
                    if (lightbox.classList.contains("active")) {
                        zavriLightbox();
                    } else if (detailyBlok.classList.contains("active")) {
                        zavriDetailZakazky();
                    }
                }

                if (!lightbox.classList.contains("active")) return;
                if (event.key === "ArrowRight") lightboxNext.click();
                if (event.key === "ArrowLeft") lightboxPrev.click();
            });
        });
    </script>

</body>
</html>
